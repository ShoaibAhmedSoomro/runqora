{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Runqora",
  "version": "0.2.3",
  "identifier": "dev.runqora.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Runqora",
        "width": 1040,
        "height": 700,
        "minWidth": 560,
        "minHeight": 480,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "Shoaib Ahmed Soomro",
    "copyright": "Copyright (c) 2026 Shoaib Ahmed Soomro",
    "category": "DeveloperTool",
    "shortDescription": "Local web stack for Windows",
    "longDescription": "Runqora installs and runs Apache, PHP, MariaDB, phpMyAdmin, Tomcat, Mailpit and more on your PC, with sites, HTTPS, updates and a command line.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Runqora",
        "installerHooks": "installer-hooks.nsh",
        "template": "installer.nsi"
      }
    }
  }
}
