    {
      "id": "tomcat",
      "name": "Apache Tomcat",
      "version": "10.1.61",
      "url": "https://archive.apache.org/dist/tomcat/tomcat-10/v10.1.61/bin/apache-tomcat-10.1.61.tar.gz",
      "strip_prefix": "apache-tomcat-10.1.61/",
      "extract_to": "tomcat",
      "binary": "tomcat/bin/bootstrap.jar",
      "exe": "jre/bin/java",
      "needs": [
        "jre"
      ],
      "args": [
        "-Dcatalina.home={root}/tomcat",
        "-Dcatalina.base={root}/tomcat",
        "-Djava.io.tmpdir={root}/tomcat/temp",
        "-Dfile.encoding=UTF-8",
        "-Djava.util.logging.config.file={root}/tomcat/conf/logging.properties",
        "-Djava.util.logging.manager=org.apache.juli.ClassLoaderLogManager",
        "--add-opens=java.base/java.lang=ALL-UNNAMED",
        "--add-opens=java.base/java.io=ALL-UNNAMED",
        "--add-opens=java.base/java.util=ALL-UNNAMED",
        "--add-opens=java.base/java.util.concurrent=ALL-UNNAMED",
        "--add-opens=java.rmi/sun.rmi.transport=ALL-UNNAMED",
        "-classpath",
        "{root}/tomcat/bin/bootstrap.jar:{root}/tomcat/bin/tomcat-juli.jar",
        "org.apache.catalina.startup.Bootstrap",
        "start"
      ],
      "write_pid": true,
      "pidfile": "tomcat/temp/runqora.pid",
      "shutdown_port": 8005,
      "shutdown_text": "SHUTDOWN",
      "port": 8080,
      "admin_url": "http://localhost:{port}/",
      "configs": [
        "tomcat/conf/server.xml",
        "tomcat/conf/tomcat-users.xml"
      ],
      "sha512": "35120a2b1182bac3d55438fbec0dc581d03b0f1c16ce692a930f3bb6a1097cf896b94b389152257071a87cb2928ac8c15f1bad08387c14acc7c17dbc1bb598fb",
      "sha256": ""
    },
